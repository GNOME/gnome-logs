#: ../data/gnome-system-log.desktop.in.in.h:1 ../src/logview-app.c:305
#: ../src/logview-window.c:1246
msgid "System Log"
msgstr "Sistem jurnalı"

#: ../data/gnome-system-log.desktop.in.in.h:2
msgid "View or monitor system log files"
msgstr "Sistemin jurnal fayllarına baxın və ya nəzarət edin"

#: ../data/gnome-system-log.desktop.in.in.h:3
msgid "logs;debug;error;"
msgstr "jurnal;sazlama;xəta;"

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:1
msgid "Log file to open up on startup"
msgstr "Başlanğıcda açılacaq jurnal faylı"

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:2
msgid ""
"Specifies the log file displayed at startup. The default is either "
"/var/adm/messages or /var/log/messages, depending on your operating system."
msgstr ""
"Başlanğıc zamanı göstərilən jurnal faylını təyin edir. Standart olaraq, "
"əməliyyat sisteminizdən asılı olaraq, /var/adm/messages və ya "
"/var/log/messages faylı istifadə olunur."

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:3
msgid "Size of the font used to display the log"
msgstr "Jurnal qeydini göstərmək üçün istifadə olunacaq şrift ölçüsü"

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:4
msgid ""
"Specifies the size of the fixed-width font used to display the log in the "
"main tree view. The default is taken from the default terminal font size."
msgstr ""
"Əsas ağac görünüşündə jurnalın göstərilməsi üçün istifadə olunan sabit enli "
"şriftin ölçüsünü təyin edir. Standart ölçü terminalın standart şrift "
"ölçüsündən götürülür."

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:5
msgid "Height of the main window in pixels"
msgstr "Əsas pəncərənin piksellərlə hündürlüyü"

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:6
msgid "Specifies the height of the log viewer main window in pixels."
msgstr ""
"Jurnal görüntüləyicisinin əsas pəncərəsinin hündürlüyünü piksel ilə təyin "
"edir."

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:7
msgid "Width of the main window in pixels"
msgstr "Əsas pəncərənin piksellərlə eni"

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:8
msgid "Specifies the width of the log viewer main window in pixels."
msgstr ""
"Jurnal görüntüləyicisinin əsas pəncərəsinin enini piksel ilə təyin edir."

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:9
msgid "Log files to open up on startup"
msgstr "Başlanğıcda açılacaq jurnal faylları"

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:10
msgid ""
"Specifies a list of log files to open up at startup. A default list is "
"created by reading /etc/syslog.conf."
msgstr ""
"Başlanğıc zamanı açılacaq jurnal fayllarının siyahısını təyin edir. Standart "
"siyahı /etc/syslog.conf faylı oxunaraq yaradılır."

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:11
msgid "List of saved filters"
msgstr "Saxlanılmış süzgəclər"

#: ../data/org.gnome.gnome-system-log.gschema.xml.in.h:12
msgid "List of saved regexp filters"
msgstr "Saxlanılmış regexp süzgəcləri"

